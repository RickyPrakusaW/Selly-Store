      "item": [
        {
          "name": "1.1 Registrasi Customer Baru",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ricky Customer\",\n  \"email\": \"rickyprakusa28@gmail.com\",\n  \"phoneNumber\": \"089517880077\",\n  \"password\": \"PasswordKuat123!\"\n}"
            },
            "description": "### 1.1 Registrasi Customer Baru\nPendaftaran akun pelanggan baru.\n- **Status Expected:** `201 Created`\n- **Side Effect:** Mengirimkan email verifikasi otomatis via SMTP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains success true', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Kirim Ulang Email Verifikasi",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/resend-verification", "host": ["{{baseUrl}}"], "path": ["auth", "resend-verification"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rickyprakusa28@gmail.com\"\n}"
            },
            "description": "### 1.2 Kirim Ulang Email Verifikasi\nMeminta ulang token verifikasi email baru jika token lama expired.\n- **Status Expected:** `200 OK` (Rate limit: 1x / 60 detik)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
