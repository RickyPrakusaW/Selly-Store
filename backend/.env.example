PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,https://app.example.com

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seli_florist
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Use independent random values of at least 32 bytes in production.
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_MAPS_API_KEY=your_google_maps_key
TOKO_ORIGIN_LAT=-7.257472
TOKO_ORIGIN_LNG=112.752088
ONGKIR_BASE_KM=4
ONGKIR_BASE_FEE=10000
ONGKIR_PER_KM_FEE=2500

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@example.com
FONNTE_TOKEN=

MAX_UPLOAD_SIZE_MB=5
DP_DEADLINE_HOURS=2
PELUNASAN_DEADLINE_DAYS=3
REFUND_TIER1_HOURS=12
REFUND_TIER1_DEDUCTION=0
REFUND_TIER2_HOURS=24
REFUND_TIER2_DEDUCTION=25
REFUND_TIER3_DEDUCTION=50

# DOKU Payment Gateway (Integrasi Custom QRIS)
# Dapatkan Client ID & Secret Key dari https://dashboard.doku.com/bo/integrations
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=false
DOKU_NOTIFICATION_URL=http://localhost:3000/api/payments/doku/notify

# Optional seed-only values; no default privileged password is provided.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Seli Florist Owner
SEED_BOARD_COUNT=3
