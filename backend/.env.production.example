PORT=3000
NODE_ENV=production
BASE_URL=https://api.example.com
FRONTEND_URL=https://www.example.com
ALLOWED_ORIGINS=https://www.example.com,https://example.com
ENABLE_SWAGGER=false
UPLOAD_DIR=/data/uploads

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-in-host-secret-manager

JWT_SECRET=generate-at-least-32-random-bytes
JWT_REFRESH_SECRET=generate-a-different-32-byte-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_MAPS_API_KEY=replace-in-host-secret-manager
TOKO_ORIGIN_LAT=-7.257472
TOKO_ORIGIN_LNG=112.752088
ONGKIR_BASE_KM=4
ONGKIR_BASE_FEE=10000
ONGKIR_PER_KM_FEE=2500

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@example.com
FONNTE_TOKEN=

MAX_UPLOAD_SIZE_MB=5
DP_DEADLINE_HOURS=2
PELUNASAN_DEADLINE_DAYS=3
REFUND_TIER1_HOURS=12
REFUND_TIER1_DEDUCTION=0
REFUND_TIER2_HOURS=24
REFUND_TIER2_DEDUCTION=25
REFUND_TIER3_DEDUCTION=50

PAYMENT_PROVIDER=doku
DOKU_CLIENT_ID=replace-with-production-client-id
DOKU_SECRET_KEY=replace-in-host-secret-manager
DOKU_IS_PRODUCTION=true
DOKU_NOTIFICATION_URL=https://api.example.com/api/payments/doku/notify

# Enable only while seeding the Rp1/Rp2 live payment smoke-test catalog.
LIVE_PAYMENT_TEST_PRICES=false
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=replace-in-host-secret-manager
SEED_OWNER_NAME=Seli Florist Owner
SEED_BOARD_COUNT=3
